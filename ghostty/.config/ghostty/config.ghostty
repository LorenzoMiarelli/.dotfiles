# Ghostty (macOS) - https://ghostty.org/docs/config

font-family = FiraCode Nerd Font
font-size = 14
theme = Catppuccin Mocha

window-padding-x = 10
window-padding-y = 5
window-save-state = always
scrollback-limit = 50000000
confirm-close-surface = false

# Left Option behaves as Alt (Alt-b/f, Alt-. in the shell, tmux/vim bindings).
# Right Option keeps typing special characters (AltGr on US International).
macos-option-as-alt = left

# Linux-style terminal shortcuts. Ctrl+Shift+C/V/T/W/N/F are handled by Karabiner
# (turned into Cmd+...), Ctrl-C stays SIGINT
keybind = ctrl+page_up=previous_tab
keybind = ctrl+page_down=next_tab
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
